<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HidRateProbe</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Step-2 reader core lives next door so ReflexX can take the file
         verbatim; compiling it here keeps it verified and drives -decode. -->
    <Compile Include="..\raw-hid-xinput\RawHidGamepadReader.cs" Link="RawHidGamepadReader.cs" />
  </ItemGroup>

</Project>
